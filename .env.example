# ==============================================================================
# Modèle de variables d'environnement — Onde Libre Studio
# Copier vers .env en local sans jamais commiter le fichier .env.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Variables publiques (exposables côté client uniquement pour Auth/RLS)
# Adapter le préfixe selon la stack retenue au Jalon 2 (NEXT_PUBLIC_ ou VITE_)
# ------------------------------------------------------------------------------
PUBLIC_SUPABASE_URL=https://votre-projet.supabase.co
PUBLIC_SUPABASE_ANON_KEY=remplacer-par-cle-anon-publique

# ------------------------------------------------------------------------------
# 2. Secrets strictement serveur (INTERDIT dans le navigateur / bundle client)
# Utilisés uniquement dans les routes serveur / Supabase Edge Functions
# ------------------------------------------------------------------------------
SUPABASE_SERVICE_ROLE_KEY=remplacer-par-cle-service-role-serveur-uniquement

# Intégration externe (Étape 5 : RSS Apple Podcasts / Spotify / Ausha)
EXTERNAL_PODCAST_PROVIDER=rss
EXTERNAL_PODCAST_FEED_URL=https://exemple-flux-podcast.tld/feed.xml
EXTERNAL_PODCAST_API_KEY=
EXTERNAL_PODCAST_API_SECRET=
